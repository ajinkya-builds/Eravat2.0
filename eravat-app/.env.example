# Copy to `.env.local` (or `.env` in eravat-app/). Real secrets stay in gitignored files only.
# Project ref: mnytrlcmdpkfhrzrtesf
#
# Vite — publishable key only (safe in browser bundle)
VITE_SUPABASE_URL=https://mnytrlcmdpkfhrzrtesf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
#
# PostHog (observability + product analytics) — Project API key from PostHog → Project Settings
# Wizard + app both accept VITE_POSTHOG_PROJECT_TOKEN (preferred). VITE_POSTHOG_KEY is an alias.
# Use Staging project key in .env.staging.local; Production key in .env.production.local
# Leave empty locally to disable (app still works; no remote telemetry)
# VITE_POSTHOG_PROJECT_TOKEN=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_APP_ENV=development
# VITE_APP_VERSION=2.0.0
# VITE_POSTHOG_KEY=   # optional alias for PROJECT_TOKEN
#
# Optional: reduce refresh noise when offline
# VITE_SUPABASE_DISABLE_AUTO_REFRESH=true
#
# Server / Edge / CLI — never VITE_* prefix (Edge Functions on Supabase still receive SUPABASE_ANON_KEY as the injected name)
SUPABASE_URL=https://mnytrlcmdpkfhrzrtesf.supabase.co
SUPABASE_ANON_KEY=
# From Dashboard → API → Secret key (sb_secret_...) — same value as in your local .env.local
SUPABASE_SERVICE_ROLE_KEY=
