# Copy to keystore.properties and fill when you recover the ORIGINAL staging signing keystore.
# Do NOT create a new keystore — field 2.1.6 APKs will refuse updates signed with a different key.
#
# Expected layout (either path works with scripts/set-android-signing-secrets.sh):
#   eravat-app/android/release.jks
#   OR backups/android-signing/release.jks

storeFile=release.jks
storePassword=PASTE
keyAlias=PASTE
keyPassword=PASTE
