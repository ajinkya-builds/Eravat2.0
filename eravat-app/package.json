{
  "name": "eravat-app",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "vite build --base=/Eravat2.0/",
    "deploy": "gh-pages -d dist",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:android-compat": "bash scripts/android-compat-smoke.sh",
    "build:android:staging": "node scripts/sync-version.mjs && node scripts/build-android-staging.mjs",
    "test:e2e": "npx playwright test",
    "test:notifications": "node scripts/test-notifications-integration.mjs",
    "test:certify": "node scripts/go-live-certification.mjs",
    "test:certify:deep": "node scripts/go-live-certification.mjs",
    "test:certify:emulator": "node scripts/go-live-certification.mjs --emulator",
    "test:staging:deep": "node scripts/staging-deep-journeys-e2e.mjs",
    "test:android:certify": "node scripts/emulator-certification.mjs",
    "test:maestro": "node scripts/maestro-certification.mjs",
    "test:setup-tooling": "node scripts/setup-test-tooling.mjs",
    "test:push-pipeline": "node scripts/staging-push-pipeline-e2e.mjs",
    "test:certify:quick": "node scripts/go-live-certification.mjs --quick",
    "test:staging:notifications": "node scripts/staging-notification-alerts-e2e.mjs",
    "publish:staging-apk": "node scripts/publish-staging-apk.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "test:e2e:headed": "npx playwright test --project=chromium --headed",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report",
    "seed:e2e": "node scripts/seed-e2e-test-users.mjs",
    "smoke:manual": "node scripts/manual-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.0.1",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.1.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/pwa-elements": "^3.4.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tailwindcss/vite": "^4.2.0",
    "@turf/turf": "^7.3.4",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "framer-motion": "^12.34.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "posthog-js": "^1.411.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "wkx": "^0.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.14",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "core-js": "^3.50.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "regenerator-runtime": "^0.14.1",
    "tailwindcss": "^4.2.0",
    "terser": "^5.50.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  },
  "browserslist": [
    "Chrome >= 53",
    "Android >= 7"
  ]
}
